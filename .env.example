# ==========================================
# BISense Environment Variables Template
# ==========================================
# Copy this file to .env and configure your keys:
#   copy .env.example .env

# Groq API Key for AI Technical Explanations & Recommendations (Llama 3.3 70B)
# Get your free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Default LLM Provider: groq, gemini, openai, or auto
DEFAULT_LLM_PROVIDER=groq

# (Optional) Google Gemini API Key
GEMINI_API_KEY=

# (Optional) OpenAI API Key
OPENAI_API_KEY=

# Database URL
DATABASE_URL=sqlite:///./data/bis_standards.db

# Semantic Embedding Model
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
